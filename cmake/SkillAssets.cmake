# SKILL.md stays explicitly listed in resources.qrc. Collect companion files
# from each package directory without shipping caches or local development files.
function(ua_add_skill_assets target)
    set(roots
        "${PROJECT_SOURCE_DIR}/resources/skills"
        "${PROJECT_SOURCE_DIR}/resources/skills-upstream/rea"
        "${PROJECT_SOURCE_DIR}/resources/skills-upstream/reverse-skill")
    set(assets)
    set(aliases)
    foreach(root IN LISTS roots)
        file(GLOB manifests CONFIGURE_DEPENDS "${root}/*/SKILL.md")
        foreach(manifest IN LISTS manifests)
            get_filename_component(package_dir "${manifest}" DIRECTORY)
            get_filename_component(package "${package_dir}" NAME)
            file(GLOB_RECURSE candidates CONFIGURE_DEPENDS LIST_DIRECTORIES false "${package_dir}/*")
            foreach(path IN LISTS candidates)
                file(RELATIVE_PATH relative "${package_dir}" "${path}")
                if(relative STREQUAL "SKILL.md" OR relative MATCHES "(^|/)(\\.[^/]*|node_modules|__pycache__)(/|$)" OR relative MATCHES "\\.(pyc|pyo|tmp)$")
                    continue()
                endif()
                if(IS_SYMLINK "${path}")
                    message(FATAL_ERROR "Symlink is not a bundled skill asset: ${path}")
                endif()
                set(alias "${package}/${relative}")
                if(alias IN_LIST aliases)
                    message(FATAL_ERROR "Duplicate skill asset alias: ${alias}")
                endif()
                list(APPEND aliases "${alias}")
                set_source_files_properties("${path}" PROPERTIES QT_RESOURCE_ALIAS "${alias}")
                list(APPEND assets "${path}")
            endforeach()
        endforeach()
    endforeach()
    if(assets)
        qt_add_resources(${target} "${target}_skill_assets" PREFIX "/skills" FILES ${assets})
    endif()
endfunction()
